{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/colorstack-utd run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "artifacts/colorstack-utd/dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
