{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/shpe-utd run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "artifacts/shpe-utd/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
